      "fr": "Coyote",
      "jp": "コヨーテ",
      "pl": "Coyote",
      "tu": "Coyote",
      "kr": "Coyote"
    },
    "olive": {
      "en": "Olive",
      "ru": "Олива",
      "ch": "橄榄绿",
      "es": "Verde Oliva",
      "po": "Verde Oliva",
      "ge": "Oliv",
      "fr": "Olive",
      "jp": "オリーブ",
      "pl": "Oliwkowy",
      "tu": "Zeytin Yeşili",
      "kr": "Olive"
    },
    "multicam": {
      "en": "MultiCam",
      "ru": "MultiCam",
      "ch": "复合迷彩",
      "es": "MultiCam",
      "po": "MultiCam",
      "ge": "MultiCam",
      "fr": "MultiCam",
      "jp": "マルチカム",
      "pl": "MultiCam",
      "tu": "MultiCam",
      "kr": "MultiCam"
    },
    "black": {
      "en": "Black",
      "ru": "Черный",
      "ch": "黑色",
      "es": "Negro",
      "po": "Preto",
      "ge": "Schwarz",
      "fr": "Noir",
      "jp": "ブラック",
      "pl": "Czarny",
      "tu": "Siyah",
      "kr": "검은색"
    },
    // The summer EMR pattern; the game calls it "Флора Цифра" in Russian and "Digital Flora"
    // in most other languages.
    "emr_summer": {
      "en": "EMR",
      "ru": "Флора Цифра",
      "ch": "数码丛林迷彩",
      "es": "EMR",
      "po": "Digital Flora",
      "ge": "Digitalflora",
      "fr": "Digital Flora",
      "jp": "デジタルフローラ",
      "pl": "Digital Flora",
      "tu": "EMR",
      "kr": "Digital Flora"
    }
  },

  // The description every rig gets. What the rigs differ in - model, protection, weight - the
  // name and the stats already say; what they all share is where the storage comes from, and
  // that is the one thing a player cannot work out by looking at the item.
  "vestDescription": {
    "en": "An armor carrier with bare MOLLE webbing and no pockets of its own. Its storage is whatever pouches are mounted on it in the MODDING screen.",
    "ru": "Бронированный носитель с голой системой MOLLE и без собственных карманов. Весь объём дают подсумки, навешенные на него в окне модификации.",
    "ch": "带裸露 MOLLE 织带的防弹载具，本身没有任何口袋。容量全部来自在改装界面挂载的附包。",
    "es": "Un portaplacas con cinchas MOLLE desnudas y sin bolsillos propios. Su capacidad es la de las bolsas que se le monten en la pantalla MODIFICAR.",
    "po": "Um colete com fitas MOLLE nuas e sem bolsos próprios. Sua capacidade vem das bolsas montadas nele na tela de MODIFICAÇÃO.",
    "ge": "Ein Trägersystem mit blankem MOLLE-Gewebe und ohne eigene Taschen. Der Stauraum sind allein die Taschen, die im MODIFIKATION-Menü angebracht werden.",
    "fr": "Un porte-plaques à sangles MOLLE nues, sans poches propres. Sa capacité se résume aux poches montées dessus depuis l'écran CUSTOMISATION.",
    "jp": "MOLLE ウェビングがむき出しで、ポケットを一切持たないキャリア。収納は改造画面で装着したポーチがすべて。",
    "pl": "Nośnik płyt z gołymi taśmami MOLLE, bez własnych kieszeni. Cała pojemność pochodzi z kieszeni zamontowanych w ekranie MODYFIKACJA.",
    "tu": "Çıplak MOLLE dokumalı, kendine ait hiçbir cebi olmayan bir taşıyıcı. Tüm hacmi ÖZELLEŞTİRME ekranından takılan çantalardan gelir.",
    "kr": "MOLLE 웨빙만 있고 자체 주머니가 없는 캐리어. 수납은 개조 화면에서 장착한 파우치가 전부다."
  },

  // The description every pouch gets. The name says what it is, the grid says how much it
  // holds; the only thing left to say is that it goes on a modular rig rather than in a bag.
  "pouchDescription": {
    "en": "A MOLLE pouch. Mounts on a modular rig in the MODDING screen.",
    "ru": "Подсумок MOLLE. Навешивается на модульную разгрузку в окне модификации.",
    "ch": "MOLLE 附包。在改装界面挂载到模块化背心上。",
    "es": "Bolsa MOLLE. Se monta en un chaleco modular desde la pantalla MODIFICAR.",
    "po": "Bolsa MOLLE. Montada em um colete modular na tela de MODIFICAÇÃO.",
    "ge": "MOLLE-Tasche. Wird im MODIFIKATION-Menü an einer modularen Weste angebracht.",
    "fr": "Poche MOLLE. Se monte sur un gilet modulaire depuis l'écran CUSTOMISATION.",
    "jp": "MOLLE ポーチ。改造画面でモジュラーキャリアに装着する。",
    "pl": "Kieszeń MOLLE. Montowana na kamizelce modułowej w ekranie MODYFIKACJA.",
    "tu": "MOLLE çantası. ÖZELLEŞTİRME ekranından modüler yeleğe takılır.",
    "kr": "MOLLE 파우치. 개조 화면에서 모듈형 캐리어에 장착한다."
  },

  // Ten carriers, each in the five colours above: one entry per carrier, one rig per colour
  // ("variants"). A colour that took over a key the mod already shipped names it in "itemKey" -
  // that item keeps its id, its cells and its preset, and only its look changes. The recoloured
  // bundles are built from the donors' own bundles by build/build-vest-bundles.ps1.
