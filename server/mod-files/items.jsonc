// Modular Vests line-up.
//
// Every id in the database is derived from the "key" fields below
// (SHA-1 of "modularvests:<kind>:<key>..."). Renaming a key changes the id and
// orphans every copy of that item in existing profiles - never rename a shipped key.
//
// The whole line-up is sold by the mod's own trader (trader/trader.jsonc). A rig or a pouch
// may set "loyaltyLevel" (1-4, default 1): the trader level it is sold from.
//
// Languages: the game ships en, ru, ch, cz, es, es-mx, fr, ge, hu, it, jp, kr, pl, po, ro, sk, tu.
// A language without its own text falls back to "en", so only the ones written here need entries.
// Short names reuse the donor's own short name from the game's locales plus an " M" marker, so
// that the abbreviations are the ones the player already reads on the vanilla item.
{
  // Name of a pouch cell, over an empty cell in the inspect window ("en" for other languages).
  // The game's own cell labels are upper case and short: MOD_MAGAZINE reads "MAGAZINE" / "МАГАЗИН".
  "pouchSlotName": {
    "en": "POUCH",
    "ru": "ПОДСУМОК",
    "ch": "附包",
    "es": "BOLSA",
    "po": "BOLSA",
    "ge": "TASCHE",
    "fr": "POCHE",
    "jp": "ポーチ",
    "pl": "KIESZEŃ",
    "tu": "ÇANTA",
    "kr": "파우치"
  },

  // Colour names, written once for the whole line-up: every pouch offers the same five.
  // The keys are part of the pouch ids and of the bundle names - never rename one.
  // Camouflage names stay as the game writes them: Latin everywhere it keeps them Latin.
  "colors": {
    "coyote": {
      "en": "Coyote",
      "ru": "Coyote",
      "ch": "灰褐色",
      "es": "Coyote",
      "po": "Coyote",
