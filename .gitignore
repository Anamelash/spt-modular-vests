# Build output
bin/
obj/
*.user
*.suo
.vs/
.idea/
.vscode/
TestResults/

# Credentials - never commit
auth.json

# Release packages
dist/*
!dist/.gitkeep

# Local working notes and internal planning documents, not part of the mod
CLAUDE.md
.claude/

# Written by the in-game bone editor next to bones.json
client/ModularVests.Client/bones.backup.json

# Built model bundles: produced by build/build-bundles.ps1 (pouches) and
# build/build-vest-bundles.ps1 (rigs) from the art sources below.
server/bundles/
server/bundles.json

# Art sources: the pouch model kits and the rig recolour inputs. Gigabytes of
# .blend files, 8k textures and review renders; the build scripts read them from
# a local working copy. Only the notes that describe the pipeline are kept.
assets/pouches/*
!assets/pouches/README.md
assets/vests/*
!assets/vests/README.md
!assets/vests/levels.json
!assets/vests/palette.json
!assets/vests/status.json

# Generated placeholder icons (build/render-pouch-fit-icons.ps1)
assets/icons/

# Scratch: one-off scripts, contact sheets and throwaway renders
_work/
__pycache__/
*.pyc

# Unity bundle project: generated / machine-local
unity/Library/
unity/Logs/
unity/UserSettings/
unity/Temp/
unity/obj/
unity/BundleOutput/
unity/MemoryCaptures/
unity/build.log
unity/.vsconfig
unity/*.csproj
unity/*.sln
# copied from assets/pouches and generated by the builder on every build
unity/Assets/ModularVests/Source/
unity/Assets/ModularVests/Source.meta
unity/Assets/ModularVests/Generated/
unity/Assets/ModularVests/Generated.meta
